{
  "name": "super-ontology",
  "version": "0.1.0",
  "description": "Free, open-source desktop app for exploring local data and building interactive dashboards.",
  "main": "out/main/index.js",
  "author": "Super Ontology contributors",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.2",
    "fflate": "0.8.3",
    "read-excel-file": "9.3.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/react-grid-layout": "1.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "echarts": "6.1.0",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-grid-layout": "1.5.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "write-excel-file": "4.1.1",
    "zustand": "5.0.8"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
