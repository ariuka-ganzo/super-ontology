{
  "formatVersion": 1,
  "name": "Sample: Harbor & Pine sales",
  "model": {
    "tables": [
      {
        "id": "orders",
        "name": "Orders",
        "source": {
          "path": "orders.csv",
          "format": "csv"
        },
        "rowCount": 24003,
        "columns": [
          {
            "name": "order_id",
            "sourceType": "BIGINT",
            "type": "integer"
          },
          {
            "name": "line",
            "sourceType": "BIGINT",
            "type": "integer"
          },
          {
            "name": "order_date",
            "sourceType": "DATE",
            "type": "date"
          },
          {
            "name": "ship_date",
            "sourceType": "DATE",
            "type": "date"
          },
          {
            "name": "customer_id",
            "sourceType": "VARCHAR",
            "type": "string"
          },
          {
            "name": "product_id",
            "sourceType": "VARCHAR",
            "type": "string"
          },
          {
            "name": "channel",
            "sourceType": "VARCHAR",
            "type": "string"
          },
          {
            "name": "quantity",
            "sourceType": "BIGINT",
            "type": "integer"
          },
          {
            "name": "unit_price",
            "sourceType": "DOUBLE",
            "type": "number"
          },
          {
            "name": "discount",
            "sourceType": "DOUBLE",
            "type": "number"
          },
          {
            "name": "sales",
            "sourceType": "DOUBLE",
            "type": "number"
          },
          {
            "name": "profit",
            "sourceType": "DOUBLE",
            "type": "number"
          }
        ]
      },
      {
        "id": "customers",
        "name": "Customers",
        "source": {
          "path": "customers.csv",
          "format": "csv"
        },
        "rowCount": 800,
        "columns": [
          {
            "name": "customer_id",
            "sourceType": "VARCHAR",
            "type": "string"
          },
          {
            "name": "customer_name",
            "sourceType": "VARCHAR",
            "type": "string"
          },
          {
            "name": "segment",
            "sourceType": "VARCHAR",
            "type": "string"
          },
          {
            "name": "city",
            "sourceType": "VARCHAR",
            "type": "string"
          },
          {
            "name": "region",
            "sourceType": "VARCHAR",
            "type": "string"
          },
          {
            "name": "signup_date",
            "sourceType": "DATE",
            "type": "date"
          }
        ]
      },
      {
        "id": "products",
        "name": "Products",
        "source": {
          "path": "products.csv",
          "format": "csv"
        },
        "rowCount": 121,
        "columns": [
          {
            "name": "product_id",
            "sourceType": "VARCHAR",
            "type": "string"
          },
          {
            "name": "product_name",
            "sourceType": "VARCHAR",
            "type": "string"
          },
          {
            "name": "category",
            "sourceType": "VARCHAR",
            "type": "string"
          },
          {
            "name": "subcategory",
            "sourceType": "VARCHAR",
            "type": "string"
          },
          {
            "name": "list_price",
            "sourceType": "DOUBLE",
            "type": "number"
          },
          {
            "name": "unit_cost",
            "sourceType": "DOUBLE",
            "type": "number"
          }
        ]
      }
    ],
    "relationships": [
      {
        "id": "r_cust",
        "fromTable": "orders",
        "fromColumn": "customer_id",
        "toTable": "customers",
        "toColumn": "customer_id",
        "cardinality": "many-to-one"
      },
      {
        "id": "r_prod",
        "fromTable": "orders",
        "fromColumn": "product_id",
        "toTable": "products",
        "toColumn": "product_id",
        "cardinality": "many-to-one"
      }
    ],
    "calcs": [
      {
        "id": "profit_ratio",
        "name": "Profit Ratio",
        "formula": "SUM([profit]) / SUM([sales])"
      },
      {
        "id": "avg_customer_value",
        "name": "Average Customer Value",
        "formula": "// Sales per customer, then averaged for each mark\nAVG({INCLUDE [Orders].[customer_id] : SUM([sales])})"
      },
      {
        "id": "customer_share",
        "name": "Share of All Sales",
        "formula": "SUM([sales]) / MIN({FIXED : SUM([sales])})"
      },
      {
        "id": "running_sales",
        "name": "Running Sales",
        "formula": "RUNNING_SUM(SUM([sales]))"
      },
      {
        "id": "order_size",
        "name": "Order Size",
        "formula": "IF [quantity] >= 10 THEN \"Bulk\" ELSEIF [quantity] >= 4 THEN \"Medium\" ELSE \"Single\" END"
      },
      {
        "id": "days_to_ship",
        "name": "Days to Ship",
        "formula": "DATEDIFF('day', [order_date], [ship_date])"
      }
    ]
  },
