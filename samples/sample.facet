  "dashboards": [
    {
      "id": "overview",
      "name": "Sales overview",
      "pages": [
        {
          "id": "p_overview",
          "name": "Overview",
          "tiles": [
            {
              "id": "t_title",
              "kind": "text",
              "layout": {
                "x": 0,
                "y": 0,
                "w": 9,
                "h": 2
              },
              "text": "# Harbor & Pine Supply Co.\nFictional sales data, 2023 to 2025. Click a bar, slice or point to cross-filter the page; clear it with the chip at the top."
            },
            {
              "id": "t_kpi",
              "kind": "worksheet",
              "layout": {
                "x": 0,
                "y": 2,
                "w": 9,
                "h": 3
              },
              "worksheetId": "kpis"
            },
            {
